# Frontend Dockerfile: build React app and serve static files with nginx
FROM node:20-alpine AS build
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ .
ENV REACT_APP_API_URL=/api
RUN npm run build

FROM nginx:stable-alpine AS runtime
# Place the built files where our nginx.conf expects them
COPY --from=build /app/build /app/frontend_build
COPY nginx.conf /etc/nginx/nginx.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
